# Copy this file to .env for local work. NEVER commit .env, and never put real values in this example file.
# On Railway these are set as service variables. Most provider keys (SMS, email, bureau, e-sign and so on) are set on the
# portal's Integrations page instead and are stored encrypted-at-rest by the database host; they are not needed here.

# ---- Server ----
PORT=5000
NODE_ENV=development            # production on a real deployment

# ---- Database (must include a user name and password; keep the database off the public internet) ----
MONGODB_URI=mongodb://USER:PASSWORD@HOST:27017/fintech-loan

# ---- Sign-in (REQUIRED) ----
# A long random value. Generate one with:   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it signs everybody out. 32 characters is the minimum; the server refuses to start on a real deployment with less than 16.
JWT_SECRET=GENERATE_A_RANDOM_VALUE_AND_PUT_IT_HERE
JWT_EXPIRE=7d                   # customer sessions
ADMIN_JWT_EXPIRE=8h             # staff sessions

# ---- Staff ----
ADMIN_EMAIL=admin@example.com   # the super admin account
STAFF_REQUIRE_2FA=true          # two-step sign-in is required for every staff role except the super admin
# Optional: the back office answers only to these addresses (comma separated). Empty means anyone who can sign in.
ADMIN_ALLOWED_IPS=

# ---- Browsers allowed to call the API (comma separated web addresses). Set this on a real deployment. ----
ALLOWED_ORIGINS=https://your-domain.example

# ---- Protecting stored files (optional but recommended) ----
# Seals selfies and Aadhaar card photos in the database. 32 random bytes as 64 hex characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# KEEP THIS KEY OUTSIDE THE DATABASE AND BACK IT UP: without it sealed files cannot be read. Then run: node scripts/encrypt-media.mjs --apply
DATA_ENCRYPTION_KEY=
BCRYPT_COST=12                  # password hashing work factor (10 to 14)

# ---- Request limits (the defaults are sensible; raise only with a reason) ----
# API_RATE_LIMIT=200            # per address per 15 minutes
# AUTH_RATE_LIMIT=20            # sign-in attempts per address per 15 minutes
# SIGNUP_RATE_LIMIT=30          # new accounts per address per hour

# ---- Going live ----
# PAYMENT_MODE=PRODUCTION       # turns every test mode off. Providers must be configured first, or sign-up codes will not be sent.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=      # required once payments are live

# ---- Email (optional here; can also be set on the Integrations page) ----
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASSWORD=                 # an app password, never your normal one
